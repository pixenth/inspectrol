<Application x:Class="Inspectrol.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Inspectrol.App.Controls"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PageHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Quieter text uses the primary brush at reduced opacity: the theme's secondary brush is too pale in the
              light theme.  -->
        <Style x:Key="LeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="QuestionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!--  Follows the text color, so drawings work in both themes.  -->
        <Style x:Key="DrawLine" TargetType="Shape">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <!--  Negative margins stretch the line to the edges of the page area.  -->
        <Style x:Key="PageFooterDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="-32,0,-24,0" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style TargetType="controls:NumberedStep">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:NumberedStep">
                        <DockPanel>
                            <Border Width="30"
                                    Height="30"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Top"
                                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="15"
                                    DockPanel.Dock="Left">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Number, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,0" FontSize="14" Text="{TemplateBinding Text}" TextWrapping="Wrap" />
                                <TextBlock x:Name="HintBlock"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryText}"
                                           Text="{TemplateBinding Hint}" />
                            </StackPanel>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Hint" Value="{x:Null}">
                                <Setter TargetName="HintBlock" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="controls:Notice">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:Notice">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <DockPanel>
                                <TextBlock x:Name="Icon"
                                           Margin="0,1,12,0"
                                           VerticalAlignment="Top"
                                           DockPanel.Dock="Left"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Style="{StaticResource Glyph}"
                                           Text="&#xE946;" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Kind" Value="Warning">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                            </Trigger>
                            <Trigger Property="Kind" Value="Critical">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Setter TargetName="Icon" Property="Text" Value="&#xE783;" />
                            </Trigger>
                            <Trigger Property="Kind" Value="Success">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter TargetName="Icon" Property="Text" Value="&#xE73E;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
