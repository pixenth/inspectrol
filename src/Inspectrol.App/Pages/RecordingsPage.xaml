<UserControl x:Class="Inspectrol.App.Pages.RecordingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Inspectrol.App.Controls"
             xmlns:text="clr-namespace:Inspectrol.Core;assembly=Inspectrol.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" Style="{StaticResource PageHeaderText}" Text="{x:Static text:Strings.RecordingsPage_Header}" />
            <TextBlock x:Name="SummaryText" Margin="0,8,0,0" Style="{StaticResource LeadText}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="ChoicePanel" Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,12"
                               Style="{StaticResource SecondaryText}"
                               Text="{x:Static text:Strings.RecordingsPage_ChoiceExplanation}" />

                    <StackPanel x:Name="OptionsPanel" />

                    <Border x:Name="RangeCard" Margin="0,0,0,12" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{x:Static text:Strings.RecordingsPage_RangeTitle}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{x:Static text:Strings.RecordingsPage_RangeFrom}" />
                                <DatePicker x:Name="FromPicker" Width="160" SelectedDateChanged="OnRangeChanged" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{x:Static text:Strings.RecordingsPage_RangeTo}" />
                                <DatePicker x:Name="ToPicker" Width="160" SelectedDateChanged="OnRangeChanged" />
                            </StackPanel>
                            <TextBlock x:Name="RangeText" Margin="0,10,0,0" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SkipCard" Margin="0,0,0,12" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{x:Static text:Strings.RecordingsPage_SkipTitle}" TextWrapping="Wrap" />
                            <CheckBox x:Name="SkipConsent" Margin="0,10,0,0" Checked="OnSkipConsentChanged" Unchecked="OnSkipConsentChanged">
                                <TextBlock FontSize="15" Text="{x:Static text:Strings.RecordingsPage_SkipConsent}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FolderCard" Margin="0,0,0,12" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{x:Static text:Strings.RecordingsPage_FolderTitle}" />
                            <TextBlock x:Name="FolderText" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Button x:Name="FolderButton"
                                    Margin="0,10,0,0"
                                    Padding="14,6"
                                    HorizontalAlignment="Left"
                                    Click="OnChooseFolderClick"
                                    Content="{x:Static text:Strings.RecordingsPage_ChooseFolder}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="CopyPanel" Visibility="Collapsed">
                    <TextBlock x:Name="CopyText" FontSize="15" TextWrapping="Wrap" />
                    <ProgressBar x:Name="CopyBar" Height="12" Margin="0,12,0,0" Maximum="100" />
                    <TextBlock x:Name="CopyPercent" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
                </StackPanel>

                <controls:Notice x:Name="ResultNotice" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultText" FontSize="15" TextWrapping="Wrap" />
                        <Button x:Name="OpenFolderButton"
                                Margin="0,10,0,0"
                                Padding="14,6"
                                HorizontalAlignment="Left"
                                Click="OnOpenFolderClick"
                                Content="{x:Static text:Strings.RecordingsPage_OpenFolder}"
                                Visibility="Collapsed" />
                    </StackPanel>
                </controls:Notice>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PageFooterDivider}" />
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HintText"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SecondaryButton" Margin="0,0,12,0" Click="OnButtonClick" Style="{DynamicResource StepButton}" Visibility="Collapsed" />
                <Button x:Name="PrimaryButton" Click="OnButtonClick" IsDefault="True" Style="{DynamicResource PrimaryStepButton}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
