<UserControl x:Class="Inspectrol.App.Pages.DeviceActionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Inspectrol.App.Controls"
             xmlns:text="clr-namespace:Inspectrol.Core;assembly=Inspectrol.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource PageHeaderText}" />

        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <controls:Notice x:Name="CriticalNotice" Kind="Warning" Visibility="Collapsed">
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Text="{x:Static text:Strings.DeviceActionPage_UpdatingWarning}"
                               TextWrapping="Wrap" />
                </controls:Notice>

                <TextBlock x:Name="BodyText" Style="{StaticResource BodyText}" />

                <Border Margin="0,24,0,0" Style="{StaticResource Card}">
                    <TextBlock x:Name="QuestionText" Style="{StaticResource QuestionText}" />
                </Border>

                <controls:Notice x:Name="HelpNotice" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static text:Strings.DeviceActionPage_HelpTitle}" />
                        <TextBlock x:Name="HelpText" Margin="0,6,0,0" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </controls:Notice>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PageFooterDivider}" />
        <StackPanel Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="SecondaryButton" Margin="0,0,12,0" Click="OnButtonClick" Style="{DynamicResource StepButton}" />
            <Button x:Name="PrimaryButton" Click="OnButtonClick" Style="{DynamicResource PrimaryStepButton}" />
        </StackPanel>
    </Grid>
</UserControl>
