<UserControl x:Class="Inspectrol.App.Pages.ModelPickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:Inspectrol.Core;assembly=Inspectrol.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageHeaderText}" Text="{x:Static text:Strings.ModelPickerPage_Header}" />

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource LeadText}"
                       Text="{x:Static text:Strings.ModelPickerPage_Lead}" />
            <TextBox x:Name="SearchBox"
                     Margin="0,14,0,0"
                     Padding="10,8"
                     FontSize="15"
                     TextChanged="OnSearchChanged" />
        </StackPanel>

        <ListBox x:Name="ModelList"
                 Grid.Row="2"
                 Margin="0,14,0,0"
                 MouseDoubleClick="OnListDoubleClick"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock FontSize="15" Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Note}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding CanBeChosen}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Border Grid.Row="3" Style="{StaticResource PageFooterDivider}" />
        <StackPanel Grid.Row="3" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="SecondaryButton" Margin="0,0,12,0" Click="OnButtonClick" Style="{DynamicResource StepButton}" />
            <Button x:Name="PrimaryButton" Click="OnButtonClick" IsDefault="True" Style="{DynamicResource PrimaryStepButton}" />
        </StackPanel>
    </Grid>
</UserControl>
