<Window x:Class="Inspectrol.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:Inspectrol.Core;assembly=Inspectrol.Core"
        Title="{x:Static text:Strings.MainWindow_Title}"
        Width="1040"
        Height="720"
        MinWidth="860"
        MinHeight="580"
        Closing="OnClosing"
        FontSize="14"
        Icon="Assets/inspectrol.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="StepTemplate">
            <Border x:Name="Row" Margin="0,1" Padding="10,7" CornerRadius="4">
                <DockPanel>
                    <Grid Width="26" VerticalAlignment="Top" DockPanel.Dock="Left">
                        <TextBlock x:Name="Mark"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Style="{StaticResource Glyph}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="Number"
                                   Opacity="0.6"
                                   Text="{Binding Number}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock x:Name="Title"
                                   Opacity="0.75"
                                   Text="{Binding Title}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="Detail"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Text="{Binding Detail}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Current">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Mark" Property="Text" Value="&#xE76C;" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Title" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Mark" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Title" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDetail}" Value="True">
                    <Setter TargetName="Detail" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!--  A solid background instead of the translucent system backdrop keeps one calm color scheme.  -->
    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Padding="12,20,12,16"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel Margin="10,0,0,16" DockPanel.Dock="Top">
                    <DockPanel>
                        <Image Width="22"
                               Height="22"
                               Margin="0,0,8,0"
                               DockPanel.Dock="Left"
                               Source="Assets/inspectrol.ico" />
                        <TextBlock x:Name="AppNameText" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" Text="{x:Static text:Strings.MainWindow_AppSubtitle}" />
                    <TextBlock x:Name="StepCounterText"
                               Margin="0,16,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>

                <ItemsControl x:Name="StepsList" Focusable="False" ItemTemplate="{StaticResource StepTemplate}" />
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="0" Grid.Column="1" Margin="32,24,24,16" Focusable="False" />

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="22,7"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" FontSize="12" Style="{StaticResource SecondaryText}" />
        </Border>
    </Grid>
</Window>
