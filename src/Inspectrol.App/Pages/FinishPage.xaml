<UserControl x:Class="Inspectrol.App.Pages.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Style="{StaticResource PageHeaderText}" />

        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,20">
                    <TextBlock x:Name="ResultIcon"
                               Margin="0,0,18,0"
                               VerticalAlignment="Top"
                               DockPanel.Dock="Left"
                               FontSize="40"
                               Style="{StaticResource Glyph}" />
                    <TextBlock x:Name="ResultText" VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap" />
                </DockPanel>

                <Border x:Name="SummaryCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel x:Name="SummaryPanel" />
                </Border>

                <TextBlock x:Name="DetailsText" Margin="0,12,0,0" Style="{StaticResource BodyText}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PageFooterDivider}" />
        <StackPanel Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="SecondaryButton" Margin="0,0,12,0" Click="OnButtonClick" Style="{DynamicResource StepButton}" />
            <Button x:Name="PrimaryButton" Click="OnButtonClick" IsDefault="True" Style="{DynamicResource PrimaryStepButton}" />
        </StackPanel>
    </Grid>
</UserControl>
