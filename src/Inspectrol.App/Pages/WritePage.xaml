<UserControl x:Class="Inspectrol.App.Pages.WritePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Inspectrol.App.Controls"
             xmlns:text="clr-namespace:Inspectrol.Core;assembly=Inspectrol.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" Style="{StaticResource PageHeaderText}" Text="{x:Static text:Strings.WritePage_Header}" />
            <TextBlock x:Name="SubheaderText"
                       Margin="0,8,0,0"
                       Style="{StaticResource LeadText}"
                       Text="{x:Static text:Strings.WritePage_Subheader}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="CardInfoCard" Margin="0,0,0,12" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Top"
                                   DockPanel.Dock="Left"
                                   FontSize="24"
                                   Style="{StaticResource Glyph}"
                                   Text="&#xEDA2;" />
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Static text:Strings.WritePage_WhichCard}" />
                            <TextBlock x:Name="CardText" Margin="0,6,0,0" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock x:Name="CardContentsText" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="SavedText" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Top"
                                   DockPanel.Dock="Left"
                                   FontSize="24"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Style="{StaticResource Glyph}"
                                   Text="&#xE896;" />
                        <StackPanel>
                            <TextBlock x:Name="WhatTitle" FontSize="16" FontWeight="SemiBold" Text="{x:Static text:Strings.WritePage_WhatWillBeWritten}" />
                            <TextBlock x:Name="ModelText" Margin="0,6,0,0" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock x:Name="FilesText" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <controls:Notice x:Name="ProblemNotice" Kind="Critical" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProblemText" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProblemDetails" Margin="0,8,0,0" Style="{StaticResource SecondaryText}" Visibility="Collapsed" />
                    </StackPanel>
                </controls:Notice>

                <Border x:Name="ConsentCard" Style="{StaticResource Card}">
                    <CheckBox x:Name="EraseConsent" Checked="OnConsentChanged" Unchecked="OnConsentChanged">
                        <TextBlock FontSize="15" Text="{x:Static text:Strings.WritePage_EraseConsent}" TextWrapping="Wrap" />
                    </CheckBox>
                </Border>

                <Border x:Name="FallbackCard" Margin="0,12,0,0" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Static text:Strings.WritePage_KeepFilesTitle}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryText}"
                                   Text="{x:Static text:Strings.WritePage_KeepFilesExplanation}" />
                        <TextBlock x:Name="KeepFilesText" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <StackPanel x:Name="ManualSection" Margin="0,20,0,0" Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static text:Strings.WritePage_ManualFormatTitle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ManualFormatText" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Button x:Name="OpenComputerButton"
                                    Margin="0,10,0,0"
                                    Padding="16,8"
                                    HorizontalAlignment="Left"
                                    Click="OnOpenComputerClick"
                                    Content="{x:Static text:Strings.WritePage_OpenThisPc}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WritePanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" FontSize="15" TextWrapping="Wrap" />
                    <ProgressBar x:Name="WriteBar" Height="12" Margin="0,10,0,0" Maximum="100" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PageFooterDivider}" />
        <StackPanel Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="PrimaryButton" Click="OnButtonClick" Style="{DynamicResource PrimaryStepButton}" />
        </StackPanel>
    </Grid>
</UserControl>
