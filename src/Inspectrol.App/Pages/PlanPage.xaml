<UserControl x:Class="Inspectrol.App.Pages.PlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Inspectrol.App.Controls"
             xmlns:text="clr-namespace:Inspectrol.Core;assembly=Inspectrol.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" Style="{StaticResource PageHeaderText}" />
            <TextBlock x:Name="SubheaderText" Margin="0,8,0,0" Style="{StaticResource LeadText}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ProgressBar x:Name="LoadingBar" Height="4" Margin="0,0,0,16" IsIndeterminate="True" Visibility="Collapsed" />

                <StackPanel x:Name="OptionsPanel" />

                <Border x:Name="PlanCard" Margin="0,0,0,12" Style="{StaticResource Card}" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Margin="0,0,14,0"
                                   VerticalAlignment="Top"
                                   DockPanel.Dock="Left"
                                   FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Style="{StaticResource Glyph}"
                                   Text="&#xE896;" />
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Static text:Strings.PlanPage_PlanTitle}" />
                            <StackPanel x:Name="PassesPanel" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <controls:Notice x:Name="BlockerNotice" Kind="Warning" Visibility="Collapsed">
                    <TextBlock x:Name="BlockerText" TextWrapping="Wrap" />
                </controls:Notice>

                <StackPanel x:Name="WarningsPanel" />
                <StackPanel x:Name="FirmwareWarningsPanel" Visibility="Collapsed" />

                <Border x:Name="ConsentCard" Margin="0,4,0,0" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{x:Static text:Strings.PlanPage_ConsentHeader}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,12"
                                   Style="{StaticResource SecondaryText}"
                                   Text="{x:Static text:Strings.PlanPage_ConsentRisk}" />
                        <StackPanel x:Name="ConsentsPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PageFooterDivider}" />
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HintText"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SecondaryButton" Margin="0,0,12,0" Click="OnButtonClick" Style="{DynamicResource StepButton}" />
                <Button x:Name="PrimaryButton" Click="OnButtonClick" IsDefault="True" Style="{DynamicResource PrimaryStepButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
