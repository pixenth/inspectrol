<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Inspectrol.App</RootNamespace>
    <AssemblyName>Inspectrol</AssemblyName>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\inspectrol.ico</ApplicationIcon>
    <Product>Inspectrol</Product>
    <AssemblyTitle>Inspectrol — обновление регистраторов Inspector</AssemblyTitle>
    <Description>Пошаговое обновление базы камер и прошивки видеорегистраторов Inspector.</Description>
    <Company>Pavel Akulichev</Company>
    <Authors>Pavel Akulichev</Authors>
    <Copyright>© 2026 Pavel Akulichev</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Fluent theming (ThemeMode) is still marked as experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon sets the exe icon. The window references the same file through
         Icon="Assets/inspectrol.ico", which requires it to be a WPF resource as well. -->
    <Resource Include="Assets\inspectrol.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inspectrol.Core\Inspectrol.Core.csproj" />
  </ItemGroup>

</Project>
